{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=education-platform.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": true
  },
  "Jwt": {
    "Secret": "development-only-change-this-secret-to-a-long-random-value"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
