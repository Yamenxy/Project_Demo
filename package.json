{
  "name": "lms",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "pnpm --filter @lms/shared build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "lint": "pnpm build:shared && eslint . && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
