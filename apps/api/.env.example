# Copy to apps/api/.env for local development. Never commit .env files.
NODE_ENV=development
DEPLOY_TIER=local
DATA_CLASS=synthetic
PORT=3001
# The web app (Next.js proxies /api to this server).
WEB_ORIGINS=http://localhost:3000
# Local-only key for encrypting secrets at rest. Generate a new one for every other environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Development OTP delivery: 'console' prints codes; 'file' appends them to OTP_OUTBOX_FILE.
OTP_PROVIDER=console
# Email: 'none', or 'smtp' (Mailpit from docker-compose.yml; view mail at http://localhost:8025).
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
SECRET_ENCRYPTION_KEY=o3hXB9+v6AqwIa1TSiAi1uWPBqZDpnNRpv86ftWbdxw=

# Local Docker Postgres from docker-compose.yml. Local-only credentials.
# Runtime role (app_runtime), used by the API for all normal queries.
DATABASE_URL=postgres://lms_app:lms_app_local_only@localhost:5432/lms_dev
# Platform role (app_platform), used only by the restricted cross-workspace handle.
DATABASE_PLATFORM_URL=postgres://lms_platform:lms_platform_local_only@localhost:5432/lms_dev
# Migrator (schema owner). Used only by the migrate and dev-setup scripts, never by the API.
DATABASE_MIGRATOR_URL=postgres://lms_admin:lms_admin_local_only@localhost:5432/lms_dev
